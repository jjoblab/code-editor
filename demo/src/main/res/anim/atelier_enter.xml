<?xml version="1.0" encoding="utf-8"?>
<!-- Entrée de l'atelier (Home → Éditeur) : glissement vertical léger
     + fondu — cadence « fade through » Material (l'écran de départ
     s'efface complètement, l'écran cible monte doucement). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint">
    <translate
        android:fromYDelta="5%"
        android:toYDelta="0%"
        android:duration="300" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="300" />
</set>
