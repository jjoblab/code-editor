# check-external-refs.exceptions — bruit résiduel justifié, une regex ERE par ligne.
# Chaque exception doit rester motivée ; à réévaluer à chaque version du garde-fou.

# AGENT.md documente lui-même les formulations interdites pour les définir :
# les lignes qui les citent « entre guillemets » ne sont pas des usages.
^AGENT\.md:10[5-9].*(Formulations interdites|inspiré de|mieux que|équivalent de|port de|résumé de lecture)
^AGENT\.md:106.*(comme X|mieux que X|équivalent de X|port de X)

# Le garde-fou et ses tests citent inévitablement les motifs qu'ils vérifient.
^scripts/check-external-refs\.sh:.*
^scripts/check-external-refs-test\.sh:.*

# LICENSE est le texte canonique Apache 2.0, verbatim et inchangé par
# construction : sa définition légale de « Derivative Works » contient
# « derived from » — texte juridique à ne pas reformuler, pas un usage de
# comparaison de ce projet.
^LICENSE:.*

# NOTICE documente l'attribution des grammaires TextMate tierces embarquées
# (décision D3 de l'ADR-002 : vérification fichier par fichier) : la table
# fichier → source amont → titulaire EXIGE les URL des dépôts MIT concernés
# (textmate/atom/microsoft/MagicStack) — obligations de licence, pas des
# usages de comparaison de ce projet.
^NOTICE:URL github\.com/(textmate|atom|microsoft|MagicStack)$

# Les grammaires tierces embarquées (C3-quater, VERBATIM MIT) portent leur
# en-tête « information_for_contributors » d'origine — l'URL du dépôt amont
# fait partie du fichier original (attribution upstream, TextMate/VS Code).
^editor/cel-textmate/src/main/resources/textmate/[a-z]+\.tmLanguage\.json:URL github\.com/(textmate|atom|microsoft|MagicStack)$
