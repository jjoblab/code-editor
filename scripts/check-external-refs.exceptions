# check-external-refs.exceptions — bruit résiduel justifié, une regex ERE par ligne.
# Chaque exception doit rester motivée ; à réévaluer à chaque version du garde-fou.

# AGENT.md documente lui-même les formulations interdites pour les définir :
# les lignes qui les citent « entre guillemets » ne sont pas des usages.
# (Ancres re-calées sur les lignes 111-114 après le rangement de la
# documentation — la table des modules d'AGENT.md a gagné cel-textmate.)
^AGENT\.md:11[0-9].*(Formulations interdites|inspiré de|mieux que|équivalent de|port de|résumé de lecture)
^AGENT\.md:112.*(comme X|mieux que X|équivalent de X|port de X)

# Le garde-fou et ses tests citent inévitablement les motifs qu'ils vérifient.
^scripts/check-external-refs\.sh:.*
^scripts/check-external-refs-test\.sh:.*

# LICENSE est le texte canonique Apache 2.0, verbatim et inchangé par
# construction : sa définition légale de « Derivative Works » contient
# « derived from » — texte juridique à ne pas reformuler, pas un usage de
# comparaison de ce projet.
^LICENSE:.*

# NOTICE documente l'attribution des grammaires TextMate tierces embarquées
# (décision D3 de l'ADR-002 : vérification fichier par fichier) : la table
# fichier → source amont → titulaire EXIGE les URL des dépôts MIT concernés
# (textmate/atom/microsoft/MagicStack) — obligations de licence, pas des
# usages de comparaison de ce projet.
^NOTICE:URL github\.com/(textmate|atom|microsoft|MagicStack)$

# Les grammaires tierces embarquées (C3-quater, VERBATIM MIT) portent leur
# en-tête « information_for_contributors » d'origine — l'URL du dépôt amont
# fait partie du fichier original (attribution upstream, TextMate/VS Code).
# Étendu aux huit sources du plan 11 dont les en-têtes d'origine portent
# l'URL du dépôt de leur auteur (jeff-hykin, moby, worlpaker,
# KapitanOczywisty, Shopify, dustypomerleau — c, cpp, shell, dockerfile,
# go, php, ruby, rust) : même nature d'obligation de licence, texte
# verbatim des fichiers originaux.
^editor/cel-textmate/src/main/resources/textmate/[a-z]+\.tmLanguage\.json:URL github\.com/(textmate|atom|microsoft|MagicStack|jeff-hykin|worlpaker|Shopify|dustypomerleau|tamasfe|redhat-developer|moby|KapitanOczywisty)$

# « porté de <nombre> à <nombre> » est une plage numérique (taille d'un
# corpus, compteur de tests…), jamais une comparaison à un projet externe :
# le motif \bporté de\b vise « porté de <projet> ». Faux positif constaté au
# CHANGELOG du plan 11 (« corpus de grammaires porté de 10 à 23 »).
^[^:]*\.md:[0-9]+:.*porté de [0-9]+ à [0-9]+

# Les commentaires internes des grammaires tierces (champ « comment » des
# fichiers originaux VS Code/TextMate) peuvent employer des formulations
# anglaises (« same as … ») : texte verbatim des fichiers originaux, pas
# des usages de comparaison de CE projet.
^editor/cel-textmate/src/main/resources/textmate/[a-z]+\.tmLanguage\.json:[0-9]+:

# NOTICE documente l'attribution de la grammaire Kotlin embarquée (C3-sexties,
# option (b) du propriétaire) : dépôt amont mathiasfrohlich/vscode-kotlin
# (Apache-2.0, provenance vérifiée par UUID de grammaire identique) —
# obligation de licence, pas un usage de comparaison de ce projet.
^NOTICE:URL github\.com/mathiasfrohlich$

# NOTICE documente l'attribution des treize grammaires tierces du plan 11
# (mêmes obligations de licence MIT/Apache-2.0 que l'entrée précédente,
# sources amont identifiées par le cgmanifest VS Code) :
# jeff-hykin (better-c/cpp/shell-syntax), worlpaker (go-syntax),
# Shopify (ruby-lsp), dustypomerleau (rust-syntax), tamasfe (taplo),
# redhat-developer (vscode-yaml) — obligations de licence, pas des
# usages de comparaison de ce projet.
^NOTICE:URL github\.com/(jeff-hykin|worlpaker|Shopify|dustypomerleau|tamasfe|redhat-developer)$
